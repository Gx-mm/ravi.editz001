{
  "routes": [

    {
      "src": "^/$",
      "dest": "/index.html"
    },

    {
      "src": "^/home$",
      "dest": "/index.html"
    },

    {
      "src": "^/trending$",
      "dest": "/trd.html"
    },

    {
      "src": "^/prompts$",
      "dest": "/ex.html"
    },

    {
      "src": "^/collections$",
      "dest": "/collection.html"
    },



    {
      "src": "^/night-glow$",
      "dest": "/ac/1/1.html"
    },

    {
      "src": "^/horror-shadow$",
      "dest": "/ac/1/2.html"
    },

    {
      "src": "^/anime-cinematic$",
      "dest": "/ac/1/3.html"
    },

    {
      "src": "^/cyberpunk-neon$",
      "dest": "/ac/1/4.html"
    },

    {
      "src": "^/moody-portrait$",
      "dest": "/ac/1/5.html"
    },

    {
      "src": "^/viral-thumbnail$",
      "dest": "/ac/1/6.html"
    },

    {
      "src": "^/ai-glow-edit$",
      "dest": "/ac/1/7.html"
    },

    {
      "src": "^/cinematic-night$",
      "dest": "/ac/1/8.html"
    },



    {
      "src": "^/index\\.html$",
      "status": 301,
      "headers": {
        "Location": "/"
      }
    },

    {
      "src": "^/trd\\.html$",
      "status": 301,
      "headers": {
        "Location": "/trending"
      }
    },

    {
      "src": "^/ex\\.html$",
      "status": 301,
      "headers": {
        "Location": "/prompts"
      }
    },

    {
      "src": "^/collection\\.html$",
      "status": 301,
      "headers": {
        "Location": "/collections"
      }
    },



    {
      "src": "^/ac/1/1\\.html$",
      "status": 301,
      "headers": {
        "Location": "/night-glow"
      }
    },

    {
      "src": "^/ac/1/2\\.html$",
      "status": 301,
      "headers": {
        "Location": "/horror-shadow"
      }
    },

    {
      "src": "^/ac/1/3\\.html$",
      "status": 301,
      "headers": {
        "Location": "/anime-cinematic"
      }
    },

    {
      "src": "^/ac/1/4\\.html$",
      "status": 301,
      "headers": {
        "Location": "/cyberpunk-neon"
      }
    },

    {
      "src": "^/ac/1/5\\.html$",
      "status": 301,
      "headers": {
        "Location": "/moody-portrait"
      }
    },

    {
      "src": "^/ac/1/6\\.html$",
      "status": 301,
