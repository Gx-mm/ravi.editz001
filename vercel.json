        "Location": "/viral-thumbnail"
      }
    },

    {
      "src": "^/ac/1/7\\.html$",
      "status": 301,
      "headers": {
        "Location": "/ai-glow-edit"
      }
    },

    {
      "src": "^/ac/1/8\\.html$",
      "status": 301,
      "headers": {
        "Location": "/cinematic-night"
      }
    },



    {
      "handle": "filesystem"
    },

    {
      "src": "/.*",
      "dest": "/index.html"
    }

